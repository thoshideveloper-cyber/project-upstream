# ---- Database ----
# Async driver URLs. Dev default is SQLite; prod uses Postgres.
#   dev :  sqlite+aiosqlite:///./upstream.db
#   prod:  postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./upstream.db

# ---- Auth (JWT in httpOnly cookies) ----
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ---- Cookies ----
# Dev (same machine):   COOKIE_SECURE=false, COOKIE_SAMESITE=lax, COOKIE_DOMAIN blank
# Prod (split origin):  COOKIE_SECURE=true,  COOKIE_SAMESITE=none, COOKIE_DOMAIN=.yourdomain.com
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- CORS ----
# Comma-separated list of allowed frontend origins (explicit; never "*" with credentials).
# Dev: http://localhost:3000
# Prod: https://your-frontend-domain.vercel.app (comma-separated if multiple)
CORS_ORIGINS=http://localhost:3000,https://build-seven-xi-52.vercel.app,https://build-git-main-upstreambuild.vercel.app,https://build-omj6it4jt-upstreambuild.vercel.app

# ---- Email sending (analyst mailbox connection) ----
# Emails send through the analyst's OWN mailbox via OAuth (Gmail API / MS Graph) —
# provider-signed SPF/DKIM, mail in their Sent folder, replies thread back. Without
# OAuth credentials the Sandbox provider simulates sends (full pipeline, no network).
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
# Google Cloud Console → OAuth client (web); redirect URI: {BACKEND_PUBLIC_URL}/email/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Azure App Registration; redirect URI: {BACKEND_PUBLIC_URL}/email/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
EMAIL_SANDBOX_ENABLED=true
EMAIL_DAILY_LIMIT_DEFAULT=50
